# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VISITOR_SESSION_SECRET: Required in production (NODE_ENV=production).
# Must be a stable, cryptographically strong random string (32+ characters).
# Used to sign and verify visitor-session tokens for conversation polling.
VISITOR_SESSION_SECRET=""

# Optional Email Integration Providers for Real Invitation Delivery:
# Resend API Key: https://resend.com
RESEND_API_KEY=""

# SendGrid API Key: https://sendgrid.com
SENDGRID_API_KEY=""

# Postmark Server Token: https://postmarkapp.com
POSTMARK_SERVER_TOKEN=""

# Default Sender Address:
EMAIL_FROM=""

# YouTube / Google Cloud OAuth 2.0 Integration (Marketing Co-Founder Publishing):
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
